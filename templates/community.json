{
  "name": "Community",
  "description": "Algemene community-server met welkomstzone, gesprekskanalen, hulp en voice.",
  "guild": {
    "verificationLevel": "medium",
    "explicitContentFilter": "members_without_roles",
    "defaultMessageNotifications": "only_mentions",
    "systemChannel": "👋│welkom",
    "afkChannel": "💤│afk",
    "afkTimeoutSeconds": 900,
    "rulesChannel": "✅│regels",
    "updatesChannel": "📣│aankondigingen",
    "community": true,
    "description": "Een community-server, ingericht met Setup Bot."
  },
  "roles": [
    {
      "key": "admin",
      "name": "Admin",
      "color": "#ed4245",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "Administrator"
      ]
    },
    {
      "key": "moderator",
      "name": "Moderator",
      "color": "#5865f2",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "ViewChannel",
        "SendMessages",
        "ReadMessageHistory",
        "ManageMessages",
        "ManageThreads",
        "ManageNicknames",
        "KickMembers",
        "BanMembers",
        "ModerateMembers",
        "MuteMembers",
        "DeafenMembers",
        "MoveMembers",
        "ViewAuditLog",
        "MentionEveryone"
      ]
    },
    {
      "key": "lid",
      "name": "Lid",
      "color": "#57f287",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "ViewChannel",
        "SendMessages",
        "SendMessagesInThreads",
        "CreatePublicThreads",
        "ReadMessageHistory",
        "AddReactions",
        "AttachFiles",
        "EmbedLinks",
        "UseExternalEmojis",
        "UseApplicationCommands",
        "Connect",
        "Speak",
        "Stream"
      ]
    },
    {
      "key": "bots",
      "name": "Bots",
      "color": "#95a5a6",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "ViewChannel",
        "SendMessages",
        "EmbedLinks",
        "ReadMessageHistory",
        "UseApplicationCommands"
      ]
    }
  ],
  "categories": [
    {
      "name": "👋 Welkom",
      "overwrites": [
        {
          "role": "@everyone",
          "allow": [
            "ViewChannel",
            "ReadMessageHistory"
          ],
          "deny": [
            "SendMessages"
          ]
        }
      ],
      "channels": [
        {
          "name": "👋│welkom",
          "type": "text",
          "topic": "Start hier: lees de regels en stel jezelf voor.",
          "overwrites": [],
          "messages": [
            {
              "content": "**Welkom!**\n\nLeuk dat je er bent. Lees even de regels in ✅│regels en stel jezelf voor in de gesprekken.\n\nVeel plezier.",
              "pin": true
            }
          ]
        },
        {
          "name": "✅│regels",
          "type": "text",
          "topic": "De huisregels van deze server.",
          "overwrites": [],
          "messages": [
            {
              "content": "**Huisregels**\n\n1. Blijf respectvol. Geen haat, pesten of intimidatie.\n2. Geen spam, reclame of ongevraagde DMs.\n3. Houd het onderwerp in het juiste kanaal.\n4. Geen NSFW-inhoud.\n5. Volg de aanwijzingen van het team op.\n\nOvertredingen kunnen leiden tot een waarschuwing, time-out of ban.",
              "pin": true
            }
          ]
        },
        {
          "name": "📣│aankondigingen",
          "type": "announcement",
          "topic": "Belangrijke updates van het team.",
          "overwrites": [
            {
              "role": "@everyone",
              "allow": [
                "ViewChannel",
                "ReadMessageHistory"
              ],
              "deny": [
                "SendMessages"
              ]
            },
            {
              "role": "moderator",
              "allow": [
                "SendMessages",
                "MentionEveryone"
              ],
              "deny": []
            }
          ]
        }
      ]
    },
    {
      "name": "💬 Gesprekken",
      "overwrites": [
        {
          "role": "@everyone",
          "allow": [],
          "deny": [
            "ViewChannel"
          ]
        },
        {
          "role": "lid",
          "allow": [
            "ViewChannel"
          ],
          "deny": []
        }
      ],
      "channels": [
        {
          "name": "🗣️│algemeen",
          "type": "text",
          "topic": "Waar alles mag, zolang het aardig blijft.",
          "overwrites": []
        },
        {
          "name": "🖼️│media",
          "type": "text",
          "topic": "Fotos, clips en memes.",
          "slowmodeSeconds": 10,
          "overwrites": []
        },
        {
          "name": "🎲│off-topic",
          "type": "text",
          "topic": "Alles wat nergens anders past.",
          "overwrites": []
        }
      ]
    },
    {
      "name": "❓ Hulp",
      "overwrites": [
        {
          "role": "@everyone",
          "allow": [],
          "deny": [
            "ViewChannel"
          ]
        },
        {
          "role": "lid",
          "allow": [
            "ViewChannel"
          ],
          "deny": []
        }
      ],
      "channels": [
        {
          "name": "❓│vragen",
          "type": "forum",
          "topic": "Stel je vraag als nieuw bericht.",
          "overwrites": [],
          "tags": [
            {
              "name": "Vraag",
              "moderated": false
            },
            {
              "name": "Opgelost",
              "moderated": true
            },
            {
              "name": "Bug",
              "moderated": false
            }
          ],
          "defaultReaction": "👍",
          "autoArchiveMinutes": 4320
        },
        {
          "name": "💡│suggesties",
          "type": "text",
          "topic": "Ideeen voor de server.",
          "slowmodeSeconds": 30,
          "overwrites": []
        }
      ]
    },
    {
      "name": "🔊 Spraak",
      "overwrites": [
        {
          "role": "@everyone",
          "allow": [],
          "deny": [
            "ViewChannel"
          ]
        },
        {
          "role": "lid",
          "allow": [
            "ViewChannel",
            "Connect",
            "Speak"
          ],
          "deny": []
        }
      ],
      "channels": [
        {
          "name": "🔊│Lounge",
          "type": "voice",
          "userLimit": 0,
          "overwrites": []
        },
        {
          "name": "🎮│Chill",
          "type": "voice",
          "userLimit": 6,
          "overwrites": []
        },
        {
          "name": "💤│afk",
          "type": "voice",
          "userLimit": 0,
          "overwrites": [
            {
              "role": "@everyone",
              "allow": [],
              "deny": [
                "ViewChannel"
              ]
            },
            {
              "role": "lid",
              "allow": [
                "ViewChannel",
                "Connect"
              ],
              "deny": [
                "Speak"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "🛡️ Staf",
      "overwrites": [
        {
          "role": "@everyone",
          "allow": [],
          "deny": [
            "ViewChannel"
          ]
        },
        {
          "role": "moderator",
          "allow": [
            "ViewChannel",
            "SendMessages",
            "ReadMessageHistory"
          ],
          "deny": []
        },
        {
          "role": "admin",
          "allow": [
            "ViewChannel"
          ],
          "deny": []
        }
      ],
      "channels": [
        {
          "name": "🛡️│staf-chat",
          "type": "text",
          "topic": "Intern overleg.",
          "overwrites": []
        },
        {
          "name": "📚│logboek",
          "type": "text",
          "topic": "Automatische logs.",
          "overwrites": []
        },
        {
          "name": "🔒│Staf Voice",
          "type": "voice",
          "overwrites": []
        }
      ]
    }
  ],
  "uncategorizedChannels": [],
  "emojis": [],
  "automod": [
    {
      "name": "Grof taalgebruik",
      "trigger": "keyword_preset",
      "presets": [
        "profanity",
        "slurs"
      ],
      "action": "block",
      "customMessage": "Dit bericht is geblokkeerd door de serverregels.",
      "exemptRoles": [
        "moderator",
        "admin"
      ]
    },
    {
      "name": "Mention-spam",
      "trigger": "mention_spam",
      "mentionLimit": 6,
      "action": "block",
      "exemptRoles": [
        "moderator",
        "admin"
      ]
    },
    {
      "name": "Spam",
      "trigger": "spam",
      "action": "alert",
      "alertChannel": "📚│logboek",
      "exemptRoles": [
        "moderator",
        "admin"
      ]
    }
  ],
  "onboarding": {
    "enabled": true,
    "mode": "default",
    "defaultChannels": [
      "👋│welkom",
      "✅│regels",
      "📣│aankondigingen",
      "🗣️│algemeen",
      "🖼️│media",
      "🎲│off-topic",
      "❓│vragen"
    ],
    "prompts": [
      {
        "title": "Waar kom je voor?",
        "singleSelect": false,
        "required": false,
        "options": [
          {
            "title": "Meepraten",
            "description": "Gewoon gezellig meedoen",
            "roles": [
              "lid"
            ],
            "channels": [
              "🗣️│algemeen"
            ]
          },
          {
            "title": "Hulp zoeken",
            "description": "Ik heb een vraag",
            "roles": [
              "lid"
            ],
            "channels": [
              "❓│vragen"
            ]
          }
        ]
      }
    ]
  }
}
