{
  "name": "discord-setup-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot die complete servers automatisch inricht vanuit JSON-templates.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "start": "node dist/index.js",
    "start:dashboard": "node dist/dashboard.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "configure-install": "tsx src/configure-install.ts",
    "invite": "tsx src/invite.ts",
    "dashboard": "tsx src/dashboard.ts",
    "demo": "tsx src/demo.ts",
    "dashboard:dev": "tsx watch src/demo.ts",
    "build:demo": "tsx scripts/build-demo.ts",
    "copy:assets": "node scripts/copy-assets.mjs",
    "gamedata:convert": "node scripts/gamedata-xml-to-json.mjs",
    "apply": "tsx src/apply-once.ts",
    "reset": "tsx src/reset-once.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
