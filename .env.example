# Bot token uit het Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=
# Optioneel: guild-id voor `npm run deploy`, om commands direct in een testserver
# te registreren (leeg laten = globaal, kan tot een uur duren). Dat handwerk is
# meestal niet nodig: de bot meldt ze bij elke start zelf aan als er iets
# veranderd is. Uit te zetten met COMMANDS_AANMELDEN=uit.
DISCORD_DEV_GUILD_ID=
# Map met template-bestanden
TEMPLATES_DIR=./templates
# Weergavenaam van de bot; wordt toegepast door `npm run configure-install`
BOT_NAME=Setup Bot
# Avatar en applicatie-icoon; wordt toegepast door `npm run configure-install`
BOT_AVATAR=./assets/logo.png
# Poort van het dashboard (`npm run dashboard`)
DASHBOARD_PORT=4000
# Adres om op te luisteren. 127.0.0.1 = alleen deze computer.
# Iets anders (bijvoorbeeld 0.0.0.0 voor je telefoon) kan alleen met inloggen aan.
DASHBOARD_HOST=127.0.0.1

# --- Inloggen met Discord (aanbevolen, verplicht buiten localhost) ---
# Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
# De URL waarop je het dashboard opent. Zet exact deze waarde + /auth/callback
# in het portal onder OAuth2 -> Redirects.
DASHBOARD_URL=http://127.0.0.1:4000
# Discord-gebruikers-ids die binnen mogen, komma-gescheiden.
# Leeg laten = alleen de eigenaar van de applicatie.
DASHBOARD_OWNERS=
# Server-ids waar deze bot iets mag, komma-gescheiden. Leeg = geen beperking.
# Handig als anderen de GitHub Action mogen starten: daar is het server-id een
# invoerveld, en dit bepaalt welke ids er uberhaupt doorheen komen.
GUILD_IDS=

# Waar back-ups van servers en oude template-versies terechtkomen
BACKUPS_DIR=./backups
HISTORY_DIR=./history

# --- Clanrangen (OSRS via WiseOldMan) ---
# Gekozen clans en koppelingen per server; één JSON-bestand per server.
CLAN_DIR=./clan
# Hoe vaak de clanrollen vanzelf worden bijgewerkt, in minuten. 0 = nooit.
# Geldt alleen voor servers waar dat in het dashboard aanstaat.
CLAN_SYNC_MINUTEN=60
# Optioneel. Zonder sleutel laat WiseOldMan 20 verzoeken per minuut toe; dat is
# voor een clan of drie ruim genoeg. Een sleutel krijg je in hun Discord.
WOM_API_KEY=
